{
  "name": "sm-autos-backend",
  "version": "1.0.0",
  "description": "S.M. Autos backend API - Node/Express + Neon Postgres + JWT auth",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
